# Copy to .env and fill in. Read by FreshServiceSettings (pydantic-settings) from the
# current working directory; real environment variables take precedence.

# Your account's Freshservice domain. The API does not answer on a custom CNAME
# (support.example.com), only on <name>.freshservice.com.
FRESH_DOMAIN=yourcompany.freshservice.com

# Profile settings -> "Your API Key". The key acts as the agent it belongs to, with that
# agent's permissions. FRESH_KEY (the old name) is still read.
FRESH_API_KEY=

# Optional: which workspace list/create calls use. Unset: the primary workspace.
# 0 on list calls: all workspaces you can see.
# FRESH_WORKSPACE_ID=2

# Optional: the agent "--mine" means (solution articles): the number in your agent
# profile's URL (/agents/<id>). There is no /agents/me endpoint. FRESH_AGENT_EMAIL works
# instead only if the key's agent has the "Manage Agents" permission.
# FRESH_AGENT_ID=
# FRESH_AGENT_EMAIL=you@yourcompany.com

# Optional: base URL for links in reports, e.g. your portal's CNAME.
# FRESH_PORTAL_URL=https://support.yourcompany.com

# Optional: which asset types count as devices (names or ids, comma-separated; their
# child types are included).
# FRESH_DEVICE_ASSET_TYPES=Hardware

# Optional: name of the placeholder vendor and product prefix for assets with none.
# FRESH_UNKNOWN_LABEL=Unknown

# Optional: ticket templates for `freshservice tickets create --template NAME`
# (see examples/ticket_templates.json), and the defaults applied before a template.
# FRESH_TEMPLATE_FILE=./examples/ticket_templates.json
# FRESH_DEFAULT_EMAIL=
# FRESH_DEFAULT_DEPARTMENT_ID=
# FRESH_DEFAULT_GROUP_ID=
# FRESH_DEFAULT_CATEGORY=
# FRESH_DEFAULT_SUBJECT=Ticket created by FreshServiceLibrary

# Optional tunables.
# FRESH_TIMEOUT=60
# FRESH_MAX_ATTEMPTS=5
# FRESH_PAGE_SIZE=100
# FRESH_MAX_WORKERS=8          # requests in flight: pages of one listing, fan-outs
